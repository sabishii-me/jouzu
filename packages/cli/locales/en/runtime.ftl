# Runtime commands and model-list labels.
jouzu-cli-workflow-sameAsMain = Same as main
jouzu-cli-subagent-thinkingRequired = Thinking: select an effort in the main session or choose an explicit effort for this role.
jouzu-cli-helpOverlay-fastMode = { $command } Fast model requests
jouzu-cli-helpOverlay-scrollback = { $command } Export transcript
jouzu-cli-modelPicker-columnName = Name
jouzu-cli-modelPicker-columnProvider = Provider
jouzu-cli-modelPicker-columnContext = Context
jouzu-cli-modelPicker-columnStrength = Strength
jouzu-cli-modelPicker-columnSpeed = Speed
jouzu-cli-modelPicker-columnCost = Cost
jouzu-cli-modelPicker-searchLabel = Search
jouzu-cli-modelPicker-noSelection = No model selected
jouzu-cli-modelPicker-clearSearch = clear search
jouzu-cli-modelPicker-keyThen = { $first } then { $second }
jouzu-cli-session-line-fast = fast
jouzu-cli-fast-usage = Use /fast, /fast on, or /fast off.
jouzu-cli-fast-busy = Wait for the current response before changing Fast mode.
jouzu-cli-fast-ineligible = Select a GPT model using an OpenAI Responses or Codex connection before turning Fast mode on.
jouzu-cli-fast-on = Fast mode on for this session. Requests use priority processing and higher usage rates.
jouzu-cli-fast-inactive = Fast mode on for this session; inactive for the selected model.
jouzu-cli-fast-off = Fast mode off for this session.
jouzu-cli-flow-resetConfirm = Flow reset discards all queued messages, flow receipts, and waits, and releases native holds. Running jobs keep running. Try /flow clear first; it repairs a stuck reservation without discarding anything. Use reset only if /flow clear does not fix the problem: run /flow reset confirm while the session is idle.
jouzu-cli-flow-resetBusy = Flow reset needs an idle session. Interrupt the running turn, then run /flow reset confirm again.
jouzu-cli-flow-resetRecovery = Flow reset released the active reservation, but recovery evidence remains. Run /flow for the remaining decision.
jouzu-cli-flow-resetDone = Flow reset completed. Destructive flow state was discarded; jobs continue running. Continue with a new message.
jouzu-cli-scrollback-busy = Wait for the current run to finish before exporting the transcript.
jouzu-cli-scrollback-alreadyOpen = A transcript export is already open.
jouzu-cli-scrollback-fullscreen = Transcript export requires fullscreen mode.
jouzu-cli-scrollback-interactive = Transcript export requires the interactive terminal.
jouzu-cli-scrollback-dumb = Transcript export is unavailable because TERM=dumb.
jouzu-cli-scrollback-tty = Transcript export requires an interactive terminal.
jouzu-cli-scrollback-toolCall = Tool call: { $name }
jouzu-cli-scrollback-toolResult = Tool result: { $name }
jouzu-cli-scrollback-toolError = Tool result: { $name } (error)
jouzu-cli-scrollback-emptySummary = (empty summary)
jouzu-cli-scrollback-noOutput = (no output)
jouzu-cli-scrollback-title = Jouzu transcript export
jouzu-cli-scrollback-sessionNamed = Session: { $session }
jouzu-cli-scrollback-session = Session
jouzu-cli-scrollback-unserializable = [unserializable arguments]
jouzu-cli-scrollback-failureDetail = Transcript export failed: { $message }
jouzu-cli-scrollback-unknownError = unknown error
jouzu-cli-scrollback-failure = Transcript export failed.
jouzu-cli-doctor-surfaceRecheck = The surface record was inspected against Pi { $recorded }, not the running Pi { $current }. Its counts describe that inspection, not verification of this runtime. Recheck changed Pi and extension surfaces before claiming coverage.
