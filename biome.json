{
	"$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.mjs",
			"scripts/**/*.mjs",
			"*.json",
			"packages/*/*.json",
			"upstream/*.json",
			"upstream/pi-content-policy/flow-ingress.js",
			"upstream/pi-content-policy/bug-report.js",
			"!package-lock.json",
			"!!**/node_modules",
			"!!packages/cli/src/flow-control/flow-runtime.ts",
			"!!packages/cli/src/flow-control/pi-native-requests.ts",
			"!!packages/cli/src/flow-control/pi-session-ingress.ts",
			"!!packages/cli/src/flow-control/pi-session-registry.ts",
			"!!packages/cli/src/flow-control/pi-session-service.ts",
			"!!packages/cli/src/flow-control/work-context.ts",
			"!!packages/cli/src/tool-arguments.ts",
			"!!scripts/multiloop-flow-transform.mjs",
			"!!**/dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
