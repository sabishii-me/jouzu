{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "jouzu-desktop",
  "version": "../package.json",
  "identifier": "ai.shisa.jouzu.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../../../packaging/launcher"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "jouzu-desktop",
        "width": 900,
        "height": 680,
        "minWidth": 560,
        "minHeight": 480,
        "create": false,
        "decorations": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Shisa, Inc.",
    "copyright": "Copyright © Shisa, Inc.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "template": "../../../packaging/launcher/installer.nsi",
        "installerHooks": "../../../packaging/launcher/installer-hooks.nsh",
        "languages": [
          "English",
          "Japanese",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "quiet"
      }
    }
  }
}
