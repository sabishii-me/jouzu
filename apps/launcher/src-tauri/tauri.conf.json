{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Jouzu Launcher",
  "version": "0.1.0",
  "identifier": "ai.shisa.jouzu.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist",
    "additionalWatchFolders": [
      "../../../packaging/launcher"
    ]
  },
  "app": {
    "windows": [
      {
        "title": "Jouzu",
        "width": 900,
        "height": 680,
        "minWidth": 560,
        "minHeight": 480,
        "create": false,
        "decorations": false,
        "maximizable": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": false,
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Japanese",
          "SimpChinese",
          "TradChinese"
        ],
        "displayLanguageSelector": true
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": []
    }
  }
}
